# General
NODE_ENV=development
PORT=7089

# DB
MONGO_URI=mongodb://mongo:27017/digiflex

# JWT
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Email
EMAIL_USER=your-gmail@example.com
EMAIL_PASS=your-gmail-app-password
EMAIL_LOGO_URL=https://digiflex.digithaigroup.com/src/assets/Logo_no_text.png

# Front-end
VITE_BASE_URL=http://localhost:7089
# Front-end URL (for CORS)
FRONTEND_URL=http://localhost:7094

# Google Calendar
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_CALENDAR_CALENDAR_ID=
GOOGLE_CALENDAR_IMPERSONATE_USER=

# Reset password
PASSWORD_RESET_EXPIRATION_HOURS=1
PASSWORD_REDIRECT_DELAY_MILLISECONDS=2000